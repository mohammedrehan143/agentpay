{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/agentpay", "destination": "/index.html" },
    { "source": "/agentpay/(.*)", "destination": "/$1" }
  ]
}
