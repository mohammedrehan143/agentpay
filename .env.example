# ========================================================
# AgentPay Environment Configuration
# ========================================================

# --------------------------------------------------------
# Mode & Server
# --------------------------------------------------------
PORT=4021

# '1' for simulated/mock recorded fixtures (no real keys needed)
# '0' to enable live AI calls and live on-chain operations
AGENTPAY_RECORDED=1

# External AI Plans discovery endpoint (default: https://aiplans.dev)
AIPLANS_BASE_URL=https://aiplans.dev

# --------------------------------------------------------
# LLM Provider (Google Gemini OR Zhipu AI)
# --------------------------------------------------------
# Option A (Recommended): Google Gemini (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Option B: Zhipu AI (GLM)
# ZHIPU_APIKEY=your_zhipu_api_key_here
# ZHIPU_MODEL=GLM-4.7-Flash
AGENTPAY_PROVIDER_TIMEOUT_MS=30000

# --------------------------------------------------------
# Merchant Settlement (Monad Testnet / x402)
# --------------------------------------------------------
# Merchant EVM address receiving funds (e.g. 0x...)
AGENTPAY_PAY_TO=

# Merchant EVM private key for signing EIP-712 payment offers
AGENTPAY_MERCHANT_PRIVATE_KEY=

# Monad Testnet RPC URL
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# x402 Facilitator URL
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_FACILITATOR_ADDRESS=
X402_FACILITATOR_SIGNER_ALLOWLIST=

# Execution lease and reconciliation intervals
AGENTPAY_EXECUTION_LEASE_MS=120000
AGENTPAY_RECONCILE_INTERVAL_MS=5000

# --------------------------------------------------------
# Operator UI (apps/operator)
# --------------------------------------------------------
OPERATOR_PORT=4022

# --------------------------------------------------------
# Client Examples (examples/buy-zhipu.ts)
# --------------------------------------------------------
# Buyer/Agent wallet private key with Monad testnet funds
AGENT_PRIVATE_KEY=
TOOLKIT_BASE_URL=http://127.0.0.1:4021
